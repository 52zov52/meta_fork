# (override defaults for production)

# Application
BCRYPT_ROUNDS=12

# config/app.php
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Logging
# config/logging.php
LOG_CHANNEL=stack
LOG_LEVEL=debug

# config/telescope.php
TELESCOPE_ENABLED=true

# Database
# config/database.php
DB_HOST=mysql
DB_DATABASE=app
DB_USERNAME=laravel
DB_PASSWORD=secret

# SPA Auth / Cookies / CORS
# config/session.php
# SESSION_DOMAIN=.domain.com
SESSION_SECURE_COOKIE=false
# SESSION_COOKIE=meta_session
# config/sanctum.php
# FRONTEND_URL host:port is included automatically; list extra domains only.
# SANCTUM_STATEFUL_DOMAINS=localhost:3001
# config/cors.php
# FRONTEND_URL is included automatically; list extra origins only.
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# Mail
# config/mail.php
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Docker
# COMPOSE_PROJECT_NAME=backend-2037
BACKEND_HTTP_PORT=8000
PHPMYADMIN_PORT=8080
# MYSQL_FORWARD_PORT=3306
DB_ROOT_PASSWORD=secret
APP_UID=1000
APP_GID=1000
